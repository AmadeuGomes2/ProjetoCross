# Copie para .env.local e preencha. Nunca versione o arquivo preenchido.
# Nenhum valor real neste arquivo.

# Banco de dados
# Caminho do arquivo SQLite. Padrao: tmp/rdo.sqlite, que o .gitignore bloqueia.
# Use ':memory:' para banco efemero.
RDO_BANCO_CAMINHO=

# Sessao e autenticacao
AUTH_SECRET=
AUTH_URL=

# Ambiente
NODE_ENV=
