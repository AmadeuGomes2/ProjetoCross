{
  "name": "rdo-digital",
  "version": "0.1.0",
  "private": true,
  "description": "RDO digital — lancamento atomico em campo, RDO diario/semanal/mensal calculado",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx src/db/seed.ts",
    "db:generate": "drizzle-kit generate && prettier --write src/db/migrations",
    "db:migrate": "tsx src/db/migrate.ts",
    "criar-engenheiro": "tsx src/db/criar-engenheiro.ts",
    "db:preparar": "npm run db:migrate && npm run db:seed",
    "telas": "node scripts/telas.mjs",
    "console": "node scripts/console.mjs",
    "demonstracao": "tsx scripts/demonstracao.ts",
    "perfis": "node scripts/valida-perfis.mjs"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "better-sqlite3": "13.0.3",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "playwright": "^1.57.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
